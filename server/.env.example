# -- Server --
NODE_ENV=development
PORT=5000

# -- Database (PostgreSQL + PostGIS) --
# Option A: Connection URL (takes precedence over discrete variables below)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/renthub_dev

# Option B: Discrete connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=renthub_dev
DB_USER=postgres
DB_PASSWORD=postgres

# -- Google OAuth --
# GOOGLE_CLIENT_ID is the audience (aud) verified on every incoming Google ID token.
# This MUST match the OAuth 2.0 Client ID registered in your Google Cloud Console for RentHub.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# -- JWT --
# JWT_EXPIRES_IN: short-lived access token lifespan (default: 15m)
JWT_SECRET=your_jwt_secret_here_minimum_16_chars
JWT_EXPIRES_IN=15m

# JWT_REFRESH_EXPIRES_IN: stateless refresh token lifespan (default: 30d)
# NOTE: Stateless refresh tokens cannot be individually revoked before expiry.
# Deactivating a user account (is_active = false) is the authoritative kill-switch.
# Refresh token rotation is NOT implemented in Day 4. See Phase 8 roadmap.
JWT_REFRESH_SECRET=your_refresh_secret_here_minimum_16_chars
JWT_REFRESH_EXPIRES_IN=30d

# -- CORS --
# CORS_ORIGIN: allowed client origin for cross-origin requests
CORS_ORIGIN=http://localhost:5173

# -- Redis (Phase 8 — session revocation, rate limiting, chatbot state) --
REDIS_HOST=localhost
REDIS_PORT=6379

# -- File Storage --
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
