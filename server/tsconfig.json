{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "../",
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@config/*": ["config/*"],
      "@db/*": ["db/*"],
      "@common/*": ["src/common/*"],
      "@modules/*": ["src/modules/*"],
      "@renthub-types/*": ["src/types/*"]
    }
  },
  "include": [
    "src/**/*",
    "config/**/*",
    "db/**/*",
    "tests/**/*",
    "scripts/**/*",
    "../shared/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
