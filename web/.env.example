# RentHub Web Environment Variables
# These are exposed to the browser via Vite's VITE_ prefix.
# Do NOT store secrets here.

# Your Google OAuth 2.0 Web Client ID
# Get it from: Google Cloud Console → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# RentHub API base URL (Vite dev proxy handles /api → localhost:3000 in dev)
# In production, set this to the deployed API origin.
VITE_API_BASE_URL=
